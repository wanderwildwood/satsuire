<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The one permission: the camera, to scan a card. Asked for the first time Scan is
         pressed, and the app works without it by typing the number or reading a picture. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <queries>
        <!-- The other apps that act on selected text, listed behind the ⋮ of a field's
             selection menu, as in every Compose app of this shop. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Glance, which draws today's tickets on the lock screen: only to say in settings
             whether it is there. -->
        <package android:name="com.wanderwildwood.hitome" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.App">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Shared from another app: a picture or a PDF with a barcode in it (Gallery, the
                 camera, an email attachment), an Apple Wallet pass, or text, which is a Catima
                 share link or a card number. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/vnd.apple.pkpass" />
                <data android:mimeType="application/vnd-com.apple.pkpass" />
                <data android:mimeType="application/vnd.apple.pkpasses" />
            </intent-filter>

            <!-- A pass file opened from Files or Email. Only passes: pictures and PDFs have
                 their own viewers, and this is not one. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.apple.pkpass" />
                <data android:mimeType="application/vnd-com.apple.pkpass" />
                <data android:mimeType="application/vnd.apple.pkpasses" />
            </intent-filter>
        </activity>

        <!-- The scanner library brings a whole scanning activity of its own; the app draws its
             own screen around the library's camera view instead, so that one is left out. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            tools:node="remove" />

        <!-- A card's barcode as a picture, handed to whichever app it is shared with. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Today's tickets by name, for Glance (com.wanderwildwood.hitome) and nobody else. -->
        <provider
            android:name=".glance.TicketsOnLockScreen"
            android:authorities="com.wanderwildwood.satsuire.glance"
            android:exported="true" />
    </application>

</manifest>
